/* ---- Custom cursor: colorful arrow, standard pointer shape ---- */
.cursor-layer{position:fixed;inset:0;pointer-events:none;z-index:9999;display:none}
html.has-cursor .cursor-layer{display:block}
html.has-cursor,html.has-cursor *{cursor:none!important}
html.has-cursor.cursor-text input,html.has-cursor.cursor-text textarea{cursor:text!important}
.cursor-arrow{position:absolute;left:0;top:0;opacity:0;will-change:transform;transition:opacity .2s}
.cursor-arrow svg{display:block;margin:-2.5px 0 0 -4.5px;transform-origin:4.5px 2.5px;filter:drop-shadow(0 1px 3px rgba(0,0,0,.55)) drop-shadow(0 0 8px rgba(244,114,182,.55));transition:transform .18s cubic-bezier(.2,.9,.3,1.4),filter .2s}
html.cursor-on .cursor-arrow{opacity:1}
html.cursor-text .cursor-arrow{opacity:0}
.cursor-arrow.hover svg{transform:scale(1.22);filter:drop-shadow(0 1px 3px rgba(0,0,0,.55)) drop-shadow(0 0 12px rgba(34,211,238,.85))}
.cursor-arrow.down svg{transform:scale(.88)}
@media (hover:none),(pointer:coarse),(prefers-reduced-motion:reduce){.cursor-layer{display:none!important}}
